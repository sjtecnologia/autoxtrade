# ============================================================
# autoxtrade — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA commite o arquivo .env no git.
# ============================================================

# ------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------
APP_VERSION=0.1.0
APP_ENV=development   # development | production

# Token de autenticação da API (gerar com: python -c "import secrets; print(secrets.token_hex(32))")
API_SECRET_TOKEN=CHANGE_ME_generate_with_secrets_token_hex_32

# ------------------------------------------------------------
# Banco de Dados — PostgreSQL
# ------------------------------------------------------------
POSTGRES_USER=autoxtrade
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=autoxtrade
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL completa (usada pelo SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://autoxtrade:CHANGE_ME_strong_password@db:5432/autoxtrade

# URL para Alembic (síncrona — necessária para migrações)
DATABASE_URL_SYNC=postgresql://autoxtrade:CHANGE_ME_strong_password@db:5432/autoxtrade

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=5        # segundos — TTL para cache de dados de mercado

# ------------------------------------------------------------
# Celery
# ------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------
# Binance
# ------------------------------------------------------------
BINANCE_API_KEY=CHANGE_ME
BINANCE_API_SECRET=CHANGE_ME
BINANCE_PAPER_MODE=true    # true = paper trading (seguro para testes)
BINANCE_TESTNET=false      # true = usar testnet da Binance (não recomendado — dados ruins)

# ------------------------------------------------------------
# Telegram Bot
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=CHANGE_ME  # Obter em @BotFather
TELEGRAM_CHAT_ID=CHANGE_ME    # Seu chat ID — obter via @userinfobot

# ------------------------------------------------------------
# MetaTrader 5 (Fase 1b — B3 e Forex)
# Deixar vazio se ainda não está usando MT5
# ------------------------------------------------------------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=         # ex: XPInvestimentos-Demo ou XPInvestimentos-Real
MT5_PATH=           # ex: C:/Program Files/MetaTrader 5/terminal64.exe

# ------------------------------------------------------------
# Next.js Frontend
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://backend:8000
NEXT_PUBLIC_API_TOKEN=CHANGE_ME_same_as_API_SECRET_TOKEN
NEXT_PUBLIC_WS_URL=ws://backend:8000/ws

# Em produção com HTTPS:
# NEXT_PUBLIC_API_URL=https://seu-dominio.com
# NEXT_PUBLIC_WS_URL=wss://seu-dominio.com/ws

# ------------------------------------------------------------
# Nginx / HTTPS (produção)
# ------------------------------------------------------------
DOMAIN=seu-dominio.com
CERTBOT_EMAIL=seu@email.com
