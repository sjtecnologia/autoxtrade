@@ -0,0 +1,57 @@
+"""In-memory execution adapter. Never imports a broker or reads credentials."""
+from decimal import Decimal
+from trading.connectors.base import BaseConnector
+from trading.connectors.types import Order, OrderSide, OrderType, OrderStatus
+from trading.safety import AccountNature
+
+
+class SimulatedConnector(BaseConnector):
+    account_nature = AccountNature.SIMULATED
+
+    def __init__(self):
+        self.prices: dict[str, Decimal] = {}
+        self.orders: dict[str, Order] = {}
+
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def get_balance(self):
+        return {}
+
+    async def get_ohlcv(self, symbol, timeframe="5m", limit=200):
+        return []
+
+    async def get_current_price(self, symbol):
+        if symbol not in self.prices:
+            raise ValueError("Supply an explicit simulated price")
+        return self.prices[symbol]
+
+    async def place_order(self, symbol, side, order_type, amount, price=None, params=None):
+        if amount <= 0:
+            raise ValueError("Quantity must be positive")
+        market = order_type == OrderType.MARKET
+        execution_price = await self.get_current_price(symbol) if market else price
+        order = Order(str(len(self.orders) + 1), symbol, side, order_type,
+                      OrderStatus.CLOSED if market else OrderStatus.OPEN,
+                      amount, price, execution_price if market else None,
+                      amount if market else Decimal("0"),
+                      Decimal("0") if market else amount, None, {"simulated": True})
+        self.orders[order.id] = order
+        return order
+
+    async def place_oco_order(self, symbol, side, amount, take_profit_price, stop_price, stop_limit_price):
+        return await self.place_order(symbol, side, OrderType.OCO, amount, stop_price)
+
+    async def cancel_order(self, order_id, symbol):
+        order = self.orders[order_id]
+        if order.symbol != symbol or order.status != OrderStatus.OPEN:
+            return False
+        order.status = OrderStatus.CANCELED
+        return True
+
+    async def get_open_orders(self, symbol=None):
+        return [o for o in self.orders.values() if o.status == OrderStatus.OPEN
+                and (symbol is None or o.symbol == symbol)]
